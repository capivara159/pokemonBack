{
    "version": 2,
    "public": true,
    "builds": [
      {
        "src": "PokemonBack/Program.cs",
        "use": "@vercel/dotnet",
        "config": {
          "runtime": "dotnet8",
          "includeFiles": [
            "PokemonBack/**/*.dll",
            "PokemonBack/**/*.json",
            "PokemonBack/**/*.runtimeconfig.json"
          ]
        }
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "/api/$1",
        "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
      },
      {
        "src": "/(.*)",
        "dest": "/$1",
        "methods": ["GET"]
      }
    ]
  }